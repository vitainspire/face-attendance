[Unit]
Description=Face Match Instance (cosine+KNN)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/app
Environment=MATCH_THRESHOLD=0.50
Environment=PATH=/home/ec2-user/.local/bin:/usr/bin:/bin
# Reads MATCHER_API_KEY from the same file webapp.service uses — the two services must
# always agree on this shared secret, so there's only one place it's ever set.
EnvironmentFile=/etc/webapp.env
ExecStart=/home/ec2-user/.local/bin/uvicorn matcher_api:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
